# NVIDIA API (get key from https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# LinkedIn OAuth App credentials (from https://www.linkedin.com/developers)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# LinkedIn refresh token — run: node scripts/get-token.js
LINKEDIN_REFRESH_TOKEN=

# LinkedIn Page ID (optional — if set, posts go to this page instead of your profile)
# Get it from your LinkedIn Page URL: https://www.linkedin.com/company/YOUR-PAGE-ID
LINKEDIN_PAGE_ID=

# Max-impressions timing (OPTIONAL)
# POST_AT_PEAK=1 → agent waits until the next peak IST hour (12-14:00, 17-21:00 IST)
#   before posting, so Indian students are actively scrolling.
# POST_TIME_IST=19:30 → agent waits until this specific IST time to post (overrides peak slots).
POST_AT_PEAK=1
# POST_TIME_IST=19:30

# Hugging Face token (free — for high-quality FLUX image generation)
# Get from: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Zapier MCP token (for posting to LinkedIn + Canva)
# Get from https://mcp.zapier.com
ZAPIER_TOKEN=

# Instagram cross-posting (via Composio managed OAuth)
# INSTAGRAM_CONNECTION_ID — set after creating the OAuth link; or set POST_TO_INSTAGRAM=1
INSTAGRAM_CONNECTION_ID=
# POST_TO_INSTAGRAM=1
# INSTAGRAM_USER_ID — Instagram Business account id (auto-detected if unset)
# Optional: INSTAGRAM_IMAGE_URL to skip card generation/upload (must be public)
# INSTAGRAM_IMAGE_URL=

# GitHub token for hosting the IG card image publicly (workflow GITHUB_TOKEN also works)
GITHUB_TOKEN=

# Canva template ID for LinkedIn post designs
# Create a template in Canva, then find its ID in the URL
CANVA_TEMPLATE_ID=

# Figma personal access token (for design assets)
# Get from https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

# Figma file key — from your Figma file URL: figma.com/file/THIS_PART/...
# Only needed if you want Figma designs exported as images
FIGMA_FILE_KEY=

# Figma frame/node ID — the specific frame to export as PNG
# Find by right-clicking a frame in Figma → Copy/Paste as → Copy link
FIGMA_FRAME_ID=

# Mailjet API (for email automation)
# Get from https://app.mailjet.com/account/api_keys
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Cosmos DB connection string (for enrollment data)
COSMOS_DB_CONNECTION_STRING=
